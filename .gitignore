# ═══════════════════════════════════════════════════════════════════════
# Delivery Multinivel BMCP — .gitignore
# ═══════════════════════════════════════════════════════════════════════

# ── Compilación y Build (Java / Maven / Spring Boot) ─────────────────
target/
**/target/
build/
**/build/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── Node / Frontend / Vite ───────────────────────────────────────────
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Secretos, Credenciales y Variables de Entorno ─────────────────────
*.env
.env.*
!.env.example
application-prod.yml
**/application-prod.yml
application-local.yml
**/application-local.yml
application-secret.yml
**/application-secret.yml
*.pem
*.key
*.pkcs12
*.p12
*.jks

# ── Volúmenes de Bases de Datos y pgAdmin ────────────────────────────
pgdata/
redisdata/
pgadmin/
**/pgadmin/
data/

# ── IDEs y Entornos de Desarrollo ────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
.factorypath
*.launch
.springBeans

# ── Logs y Diagnósticos ──────────────────────────────────────────────
*.log
logs/
**/logs/

# ── Archivos del Sistema Operativo ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak

# ── Bundles, Respaldas y Archivos Temporales ─────────────────────────
.tempmediaStorage/
.system_generated/
*.bundle
